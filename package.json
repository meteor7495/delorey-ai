{
  "name": "seloma-ai",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @seloma/api --filter @seloma/workspace --filter @seloma/widget --filter @seloma/storefront --filter @seloma/web run dev",
    "dev:api": "pnpm --filter @seloma/api dev",
    "dev:workspace": "pnpm --filter @seloma/workspace dev",
    "dev:widget": "pnpm --filter @seloma/widget dev",
    "dev:storefront": "pnpm --filter @seloma/storefront dev",
    "dev:web": "pnpm --filter @seloma/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @seloma/api prisma:migrate"
  }
}
