generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Isolation root — Database Design §5.1
model Tenant {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String   @map("owner_user_id")
  status      String   @default("active")
  /// site-starter | site-growth | site-pro | ai-sales | ai-business | trial
  plan        String   @default("trial")
  /// pending_payment | active | trial | suspended
  billingStatus String @default("trial") @map("billing_status")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships      WorkspaceMembership[]
  sessions         Session[]
  employees        Employee[]
  storeConnection      StoreConnection?
  products             Product[]
  categories           Category[]
  channels             ChannelBinding[]
  conversations        Conversation[]
  messages             Message[]
  auditTurns           AuditTurn[]
  adminAudits          AdminAuditEvent[]
  knowledgeDocs        KnowledgeDoc[]
  knowledgeChunks      KnowledgeChunk[]
  orders               Order[]
  carts                Cart[]
  storefrontOrders     StorefrontOrder[]
  storefrontSettings   StorefrontSettings?
  storefrontBanners    StorefrontBanner[]
  customers            Customer[]
  customerIdentities   CustomerIdentity[]
  customerAddresses    CustomerAddress[]
  checkoutSessions     ChannelCheckoutSession[]
  aiPolicy             TenantAiPolicy?
  aiCallEvents         AiCallEvent[]
  accessRequests       AccessRequest[]
  attributes             Attribute[]
  attributeValues        AttributeValue[]
  productAttributes      ProductAttribute[]
  productVariants        ProductVariant[]
  variantAttributeValues VariantAttributeValue[]
  inventoryLevels        InventoryLevel[]
  inventoryTransactions  InventoryTransaction[]
  discounts              Discount[]
  discountTargets        DiscountTarget[]
  articles               Article[]

  @@map("tenants")
}

/// Public landing access / signup requests (SaaS onboarding)
model AccessRequest {
  id          String   @id @default(uuid())
  fullName    String   @map("full_name")
  email       String
  phone       String
  shopName    String   @map("shop_name")
  plan        String
  status      String   @default("submitted")
  /// submitted | provisioned | paid | rejected
  tenantId    String?  @map("tenant_id")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, createdAt])
  @@map("access_requests")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships WorkspaceMembership[]
  sessions    Session[]

  @@map("users")
}

model WorkspaceMembership {
  userId   String @map("user_id")
  tenantId String @map("tenant_id")
  role     String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("workspace_memberships")
}

/// MVP: sessions in Postgres; Redis session cache is a later optimization (Database Design).
model Session {
  token     String   @id
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

model Employee {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  tone       String
  language   String   @default("fa")
  status     String   @default("inactive")
  skills     Json
  guardrails Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("employees")
}

model StoreConnection {
  id                 String    @id @default(uuid())
  tenantId           String    @unique @map("tenant_id")
  platform           String
  shopDomain         String?   @map("shop_domain")
  externalShopId     String?   @map("external_shop_id")
  credentialsCipher  String?   @map("credentials_cipher")
  syncHealth         String    @map("sync_health")
  lastSyncAt         DateTime? @map("last_sync_at")
  failureReason      String?   @map("failure_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("store_connections")
}

model Category {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  parentId       String?  @map("parent_id")
  name           String
  slug           String
  imageUrl       String?  @map("image_url")
  description    String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  externalId     String?  @map("external_id")
  sku            String
  slug           String   @default("")
  title          String
  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  currency       String   @default("IRR")
  /// Derived projection of inventory availability — kept for storefront + AI reads
  inStock        Boolean  @default(true) @map("in_stock")
  description    String?
  shortDescription String? @map("short_description")
  brand          String?
  costPrice      Decimal? @map("cost_price") @db.Decimal(18, 2)
  barcode        String?
  tags           String[] @default([])
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String[] @default([]) @map("seo_keywords")
  hasVariants    Boolean  @default(false) @map("has_variants")
  images         String[] @default([])
  categoryId     String?  @map("category_id")
  /// draft | published | archived (archived = soft delete)
  status         String   @default("published")
  /// native | shopify | woocommerce | mock
  source         String   @default("mock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems CartItem[]
  orderItems StorefrontOrderItem[]
  attributes      ProductAttribute[]
  variants        ProductVariant[]
  inventoryLevels InventoryLevel[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, externalId])
  @@index([tenantId, categoryId])
  @@index([tenantId, status, source])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@unique([tenantId, sessionId])
  @@index([tenantId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  /// Null → simple product line; set for variant-aware lines
  variantId String?  @map("variant_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([cartId, productId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

/// Native storefront orders — website + Telegram + Bale + Instagram
model StorefrontOrder {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  orderNumber      String   @map("order_number")
  status           String   @default("pending")
  /// website | telegram | bale | instagram
  channel          String   @default("website")
  paymentMethod    String   @default("cod") @map("payment_method")
  paymentAuthority String?  @map("payment_authority")
  paymentRef       String?  @map("payment_ref")
  subtotalAmount   Decimal  @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  discountCode     String?  @map("discount_code")
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency         String   @default("IRR")
  customerId       String?  @map("customer_id")
  customerName     String   @map("customer_name")
  customerPhone    String   @map("customer_phone")
  customerAddress  String   @map("customer_address")
  customerNote     String?  @map("customer_note")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    StorefrontOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, customerPhone])
  @@index([customerId])
  @@index([paymentAuthority])
  @@map("storefront_orders")
}

model Customer {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  phoneNormalized String   @map("phone_normalized")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]
  addresses  CustomerAddress[]
  orders     StorefrontOrder[]

  @@unique([tenantId, phoneNormalized])
  @@index([tenantId])
  @@map("customers")
}

model CustomerIdentity {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  /// website | telegram | bale | instagram
  channel    String
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([customerId])
  @@map("customer_identities")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  line       String
  isDefault  Boolean  @default(true) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model ChannelCheckoutSession {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @unique @map("conversation_id")
  step           String   @default("idle")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("channel_checkout_sessions")
}

model StorefrontOrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  productId  String? @map("product_id")
  /// Null → simple product line
  variantId  String? @map("variant_id")
  sku        String
  title      String
  unitPrice  Decimal @map("unit_price") @db.Decimal(18, 2)
  quantity   Int
  lineTotal  Decimal @map("line_total") @db.Decimal(18, 2)

  order   StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("storefront_order_items")
}

model StorefrontSettings {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  storeName       String   @map("store_name")
  storeSlug       String   @unique @map("store_slug")
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#ef4056") @map("primary_color")
  secondaryColor  String   @default("#0c0c0c") @map("secondary_color")
  /// Presentation pack only — catalog, orders, banners stay on their own tables.
  themeId         String   @default("zi-home") @map("theme_id")
  tagline         String?
  codEnabled      Boolean  @default(true) @map("cod_enabled")
  onlinePaymentEnabled Boolean @default(false) @map("online_payment_enabled")
  zarinpalMerchantId   String? @map("zarinpal_merchant_id")
  supportPhone    String?  @map("support_phone")
  /// Commerce settings — defaults consumed by the Commerce Core domain layer
  defaultCurrency        String  @default("IRR") @map("default_currency")
  lowStockThreshold      Int     @default(5) @map("low_stock_threshold")
  allowNegativeInventory Boolean @default(false) @map("allow_negative_inventory")
  /// draft | published
  defaultProductStatus   String  @default("draft") @map("default_product_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

model StorefrontBanner {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  title     String
  subtitle  String?
  imageUrl  String?  @map("image_url")
  href      String?
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("storefront_banners")
}

model ChannelBinding {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  channel           String
  status            String
  publicKey         String   @unique @map("public_key")
  allowedOrigins    Json     @map("allowed_origins")
  credentialsCipher String?  @map("credentials_cipher")
  webhookSecret     String?  @map("webhook_secret")
  botUsername       String?  @map("bot_username")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
  @@map("channel_bindings")
}

model Conversation {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  channel           String
  ownership         String    @default("ai_owned")
  externalThreadId  String?   @map("external_thread_id")
  escalationReason  String?   @map("escalation_reason")
  escalatedAt       DateTime? @map("escalated_at")
  handoffPacket     Json?     @map("handoff_packet")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]
  audits   AuditTurn[]

  @@unique([tenantId, channel, externalThreadId])
  @@index([tenantId])
  @@index([tenantId, ownership])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  role           String
  content        String
  citations      Json?
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId])
  @@map("messages")
}

model AuditTurn {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  decision       String
  citations      Json
  /// Gateway metering / route label (Slice 17) — tokens, provider, fallback
  gateway        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@map("audit_turns")
}

/// Append-only admin mutations (PRD-018) — never rewritten
model AdminAuditEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  actorUserId String @map("actor_user_id")
  action    String
  summary   String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("admin_audit_events")
}

/// Knowledge SoR — FAQ / policy_override / upload (upload body later)
model KnowledgeDoc {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  docType            String   @map("doc_type")
  title              String
  bodyText           String   @map("body_text")
  sourceAttribution  String   @map("source_attribution")
  status             String   @default("indexing")
  objectKey          String?  @map("object_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("knowledge_docs")
}

model KnowledgeChunk {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  knowledgeDocId String   @map("knowledge_doc_id")
  ordinal        Int
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doc    KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeDocId])
  @@map("knowledge_chunks")
}

/// Commerce orders — Order Lookup Skill reads only; no chat mutations
model Order {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  externalId         String   @map("external_id")
  orderNumber        String   @map("order_number")
  status             String
  trackingCode       String?  @map("tracking_code")
  totalAmount        Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency           String   @default("IRR")
  customerPhoneLast4 String   @map("customer_phone_last4")
  customerEmail      String?  @map("customer_email")
  syncedAt           DateTime @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("orders")
}

/// Per-tenant AI routing constraints (Provider Layer) — ops/admin, not merchant model playground
model TenantAiPolicy {
  id                 String   @id @default(uuid())
  tenantId           String   @unique @map("tenant_id")
  preferredProvider  String?  @map("preferred_provider")
  preferredModels    Json?    @map("preferred_models")
  allowedProviders   String[] @default([]) @map("allowed_providers")
  blockedProviders   String[] @default([]) @map("blocked_providers")
  fallbackOrder      String[] @default([]) @map("fallback_order")
  maxCostPerTurnUsd  Decimal? @map("max_cost_per_turn_usd") @db.Decimal(12, 6)
  maxCostPerDayUsd   Decimal? @map("max_cost_per_day_usd") @db.Decimal(12, 6)
  latencyTargetMs    Int?     @map("latency_target_ms")
  qualityTarget      String   @default("standard") @map("quality_target")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_policies")
}

/// Internal model id → provider + upstream model string
model AiModelBinding {
  id                   String   @id @default(uuid())
  internalModelId      String   @unique @map("internal_model_id")
  providerId           String   @map("provider_id")
  upstreamModel        String   @map("upstream_model")
  taskClasses          String[] @default([]) @map("task_classes")
  costTier             String   @default("cheap") @map("cost_tier")
  enabled              Boolean  @default(true)
  pricePromptPer1k     Decimal? @map("price_prompt_per_1k") @db.Decimal(12, 8)
  priceCompletionPer1k Decimal? @map("price_completion_per_1k") @db.Decimal(12, 8)
  metadata             Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([providerId, enabled])
  @@map("ai_model_bindings")
}

/// ---------------------------------------------------------------------------
/// Commerce Core (Slice 27) — attributes, variants, inventory, discounts,
/// articles. Extends the native Shop catalog; never a parallel catalog.
/// ---------------------------------------------------------------------------

/// Tenant-configurable product attribute (Color, Size, Storage, Volume, …)
model Attribute {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  /// text | number | select | multi_select | color | boolean
  type        String   @default("select")
  /// dropdown | swatch | chip | radio
  displayType String   @default("dropdown") @map("display_type")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  required    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values            AttributeValue[]
  productAttributes ProductAttribute[]
  variantValues     VariantAttributeValue[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  attributeId String   @map("attribute_id")
  value       String
  label       String?
  /// Swatch hex for color-typed attributes
  colorHex    String?  @map("color_hex")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([tenantId])
  @@index([attributeId])
  @@map("attribute_values")
}

/// Which attributes a product uses to build its variant matrix
model ProductAttribute {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  attributeId String   @map("attribute_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_attributes")
}

/// One purchasable combination. `optionsKey` = sorted attributeValueId join —
/// makes duplicate combinations impossible at the DB level.
model ProductVariant {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  productId      String   @map("product_id")
  sku            String
  barcode        String?
  optionsKey     String   @map("options_key")
  /// Null → inherits Product.price (see domain/pricing.ts)
  price          Decimal? @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(18, 2)
  weightGrams    Int?     @map("weight_grams")
  imageUrl       String?  @map("image_url")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues    VariantAttributeValue[]
  inventoryLevel     InventoryLevel?
  cartItems          CartItem[]
  orderItems         StorefrontOrderItem[]

  @@unique([tenantId, sku])
  @@unique([productId, optionsKey])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, active])
  @@map("product_variants")
}

model VariantAttributeValue {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  variantId        String @map("variant_id")
  attributeId      String @map("attribute_id")
  attributeValueId String @map("attribute_value_id")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
  @@index([tenantId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

/// Stock per variant, or per product when the product has no variants.
/// available = onHand - reserved (domain/inventory.ts)
model InventoryLevel {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  productId         String   @map("product_id")
  /// Null → product-level stock. Partial unique index keeps it one row per product.
  variantId         String?  @unique @map("variant_id")
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("inventory_levels")
}

/// Append-only stock ledger — every quantity change is auditable
model InventoryTransaction {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  inventoryLevelId String   @map("inventory_level_id")
  /// initial | adjustment | sale | reservation | reservation_release | return | restock | correction
  type             String
  quantityDelta    Int      @map("quantity_delta")
  resultingOnHand  Int      @map("resulting_on_hand")
  reason           String?
  /// order | variant | import | manual
  referenceType    String?  @map("reference_type")
  referenceId      String?  @map("reference_id")
  actorUserId      String?  @map("actor_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLevel InventoryLevel @relation(fields: [inventoryLevelId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([inventoryLevelId, createdAt])
  @@map("inventory_transactions")
}

/// Discounts never overwrite prices — effective price is computed server-side
model Discount {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  name              String
  /// Null → automatic discount (no coupon code)
  code              String?
  /// percentage | fixed
  type              String
  value             Decimal   @db.Decimal(18, 2)
  currency          String    @default("IRR")
  startsAt          DateTime? @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  active            Boolean   @default(true)
  usageLimit        Int?      @map("usage_limit")
  perCustomerLimit  Int?      @map("per_customer_limit")
  usedCount         Int       @default(0) @map("used_count")
  minCartAmount     Decimal?  @map("min_cart_amount") @db.Decimal(18, 2)
  /// Maximum discount protection for percentage discounts
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(18, 2)
  priority          Int       @default(0)
  stackable         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets DiscountTarget[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, active, startsAt, endsAt])
  @@map("discounts")
}

model DiscountTarget {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  discountId String   @map("discount_id")
  /// all | product | category | variant
  targetType String   @map("target_type")
  /// Null when targetType = all
  targetId   String?  @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, targetType, targetId])
  @@index([tenantId])
  @@index([discountId])
  @@map("discount_targets")
}

/// Storefront content — distinct from KnowledgeDoc (AI FAQ / policy SoR)
model Article {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  title            String
  slug             String
  excerpt          String?
  content          String    @default("")
  featuredImageUrl String?   @map("featured_image_url")
  categoryId       String?   @map("category_id")
  tags             String[]  @default([])
  /// draft | published | archived
  status           String    @default("draft")
  authorUserId     String?   @map("author_user_id")
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("articles")
}

/// Append-only Gateway call ledger (Provider Layer observability / cost)
model AiCallEvent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  conversationId   String?  @map("conversation_id")
  feature          String?
  taskClass        String   @map("task_class")
  routeHint        String   @map("route_hint")
  providerId       String   @map("provider_id")
  modelId          String   @map("model_id")
  internalModelId  String?  @map("internal_model_id")
  latencyMs        Int      @map("latency_ms")
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 8)
  retryCount       Int      @default(0) @map("retry_count")
  fallbackCount    Int      @default(0) @map("fallback_count")
  errorCode        String?  @map("error_code")
  cacheHit         Boolean  @default(false) @map("cache_hit")
  shadow           Boolean  @default(false)
  idempotencyKey   String?  @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([providerId, createdAt])
  @@index([conversationId])
  @@index([tenantId, feature, createdAt])
  @@map("ai_call_events")
}
