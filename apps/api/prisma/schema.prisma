generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Isolation root — Database Design §5.1
model Tenant {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String   @map("owner_user_id")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships      WorkspaceMembership[]
  sessions         Session[]
  employees        Employee[]
  storeConnection  StoreConnection?
  products         Product[]
  channels         ChannelBinding[]
  conversations    Conversation[]
  messages         Message[]
  auditTurns       AuditTurn[]
  adminAudits      AdminAuditEvent[]
  knowledgeDocs   KnowledgeDoc[]
  knowledgeChunks KnowledgeChunk[]
  orders           Order[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships WorkspaceMembership[]
  sessions    Session[]

  @@map("users")
}

model WorkspaceMembership {
  userId   String @map("user_id")
  tenantId String @map("tenant_id")
  role     String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("workspace_memberships")
}

/// MVP: sessions in Postgres; Redis session cache is a later optimization (Database Design).
model Session {
  token     String   @id
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

model Employee {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  tone       String
  language   String   @default("fa")
  status     String   @default("inactive")
  skills     Json
  guardrails Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("employees")
}

model StoreConnection {
  id                 String    @id @default(uuid())
  tenantId           String    @unique @map("tenant_id")
  platform           String
  shopDomain         String?   @map("shop_domain")
  externalShopId     String?   @map("external_shop_id")
  credentialsCipher  String?   @map("credentials_cipher")
  syncHealth         String    @map("sync_health")
  lastSyncAt         DateTime? @map("last_sync_at")
  failureReason      String?   @map("failure_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("store_connections")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  externalId  String?  @map("external_id")
  sku         String
  title       String
  price       Decimal  @db.Decimal(18, 2)
  currency    String   @default("IRR")
  inStock     Boolean  @default(true) @map("in_stock")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, externalId])
  @@map("products")
}

model ChannelBinding {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  channel           String
  status            String
  publicKey         String   @unique @map("public_key")
  allowedOrigins    Json     @map("allowed_origins")
  credentialsCipher String?  @map("credentials_cipher")
  webhookSecret     String?  @map("webhook_secret")
  botUsername       String?  @map("bot_username")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
  @@map("channel_bindings")
}

model Conversation {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  channel           String
  ownership         String    @default("ai_owned")
  externalThreadId  String?   @map("external_thread_id")
  escalationReason  String?   @map("escalation_reason")
  escalatedAt       DateTime? @map("escalated_at")
  handoffPacket     Json?     @map("handoff_packet")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]
  audits   AuditTurn[]

  @@unique([tenantId, channel, externalThreadId])
  @@index([tenantId])
  @@index([tenantId, ownership])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  role           String
  content        String
  citations      Json?
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId])
  @@map("messages")
}

model AuditTurn {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  decision       String
  citations      Json
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@map("audit_turns")
}

/// Append-only admin mutations (PRD-018) — never rewritten
model AdminAuditEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  actorUserId String @map("actor_user_id")
  action    String
  summary   String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("admin_audit_events")
}

/// Knowledge SoR — FAQ / policy_override / upload (upload body later)
model KnowledgeDoc {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  docType            String   @map("doc_type")
  title              String
  bodyText           String   @map("body_text")
  sourceAttribution  String   @map("source_attribution")
  status             String   @default("indexing")
  objectKey          String?  @map("object_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("knowledge_docs")
}

model KnowledgeChunk {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  knowledgeDocId String   @map("knowledge_doc_id")
  ordinal        Int
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doc    KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeDocId])
  @@map("knowledge_chunks")
}

/// Commerce orders — Order Lookup Skill reads only; no chat mutations
model Order {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  externalId         String   @map("external_id")
  orderNumber        String   @map("order_number")
  status             String
  trackingCode       String?  @map("tracking_code")
  totalAmount        Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency           String   @default("IRR")
  customerPhoneLast4 String   @map("customer_phone_last4")
  customerEmail      String?  @map("customer_email")
  syncedAt           DateTime @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("orders")
}
