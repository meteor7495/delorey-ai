# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# API
API_PORT=3001
DATABASE_URL=postgresql://delorey:delorey@127.0.0.1:55432/delorey
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me-in-production
CORS_ORIGINS=http://localhost:3010,http://localhost:5173

# AI Gateway (Slice 01 — optional; mock mode works without key)
AI_GATEWAY_MODE=mock
OPENAI_API_KEY=

TELEGRAM_LIVE=0
TELEGRAM_CREDENTIALS_KEY=
BALE_LIVE=0
BALE_CREDENTIALS_KEY=
PUBLIC_API_BASE_URL=http://localhost:3001
WORKSPACE_APP_URL=http://localhost:3010

# Shopify (Slice 13) — Custom app Admin API token works without OAuth.
# OAuth needs SHOPIFY_API_KEY + SHOPIFY_API_SECRET from Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
SHOPIFY_CREDENTIALS_KEY=
SHOPIFY_API_VERSION=2024-10
