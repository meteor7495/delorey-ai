# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# API
API_PORT=3001
# Local docker-compose Postgres (user/db/password: seloma). Host port 15432
# avoids Windows Hyper-V exclusions around 55xxx and a local Postgres on 5432.
# Existing delorey_pg volumes are not migrated — recreate with `docker compose down -v` then `pnpm db:up`.
DATABASE_URL=postgresql://seloma:seloma@127.0.0.1:15432/seloma
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me-in-production
CORS_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:3020,http://localhost:3000

# Native storefront (apps/storefront)
STOREFRONT_BASE_URL=http://localhost:3020
# Live Bale/Telegram webhooks need a public HTTPS URL (localhost.run / cloudflared), not localhost.
PUBLIC_API_BASE_URL=http://localhost:3001

# Payments — empty merchant = mock pay URL for local/dev
ZARINPAL_MERCHANT_ID=
# Optional dedicated merchant for Seloma SaaS wallet (falls back to ZARINPAL_MERCHANT_ID)
SELOMA_ZARINPAL_MERCHANT_ID=
# 1 = sandbox.zarinpal.com (test merchant). Empty merchant still uses local mock pay page.
ZARINPAL_SANDBOX=0
# Comma-separated emails that can call /v1/admin/billing/*
PLATFORM_ADMIN_EMAILS=
WIDGET_EMBED_BASE_URL=http://localhost:5173
WORKSPACE_BASE_URL=http://localhost:3010

# AI Gateway + Provider Layer — mock | live
# OUR Gateway is the only AI entry point. 9Router is one upstream provider.
# Providers: openai | gapgpt | liara | boxapi | ninerouter | custom | mock
AI_GATEWAY_MODE=mock
AI_GATEWAY_PROVIDER=gapgpt
# Comma-separated failover chain after primary (mock always appended for chat)
# Example: AI_GATEWAY_FALLBACK_PROVIDERS=openai,ninerouter
AI_GATEWAY_FALLBACK_PROVIDERS=
# Shared overrides (optional; presets fill defaults)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL_CHEAP=
AI_GATEWAY_MODEL_PREMIUM=
AI_GATEWAY_TIMEOUT_MS=20000
# Circuit breaker (Redis); falls back to in-memory if Redis is down
AI_GATEWAY_CIRCUIT_FAILURES=3
AI_GATEWAY_CIRCUIT_OPEN_MS=30000
# Re-sync ai_model_bindings from env on boot (0 = keep manual DB edits)
AI_GATEWAY_BINDINGS_FORCE=0

# --- Provider keys / URLs (use the one you pick in AI_GATEWAY_PROVIDER) ---
# OpenAI direct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o

# 9Router — upstream only (OpenAI-compatible). Default local dashboard:
# http://127.0.0.1:20128/v1  — NEVER point Runtime at 9Router directly.
NINEROUTER_API_KEY=
# NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# GapGPT — https://api.gapgpt.app/v1
GAPGPT_API_KEY=
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1

# Liara AI — base URL from panel (workspace-specific, required)
LIARA_API_KEY=
LIARA_BASE_URL=

# BoxAPI ChatGPT (OpenAI-compatible) — NOT the Instagram Official API spike
BOXAPI_AI_API_KEY=
# BOXAPI_AI_BASE_URL=https://ai.boxapi.ir/api/v1

TELEGRAM_LIVE=0
TELEGRAM_CREDENTIALS_KEY=
# 1 = call real Bale Bot API (tapi.bale.ai). Token is entered in Workspace → Channels, not here.
BALE_LIVE=0
# Optional encryption key for the stored bot token (defaults to JWT_SECRET)
BALE_CREDENTIALS_KEY=

# External storefront connectors (Shopify / WooCommerce) — DISABLED for Iran native shop.
# Adapter code remains in repo but modules are not loaded.
# SHOPIFY_* / WOOCOMMERCE_* env vars unused.

# Jobs — BullMQ on Redis (queue kept; external sync jobs no-op)
REDIS_URL=redis://127.0.0.1:6379
SYNC_INLINE=0

# BoxAPI Instagram Official API — channel transport (DMs → Runtime → سفارش فروشگاه)
# Docs: docs/07-evaluations/boxapi-instagram-official-api/
# BOXAPI_BASE_URL comes from vendor panel (Official docs use YOUR_BASE_URL).
BOXAPI_SPIKE_ENABLED=0
BOXAPI_LIVE=0
BOXAPI_API_KEY=
BOXAPI_BASE_URL=
BOXAPI_WEBHOOK_SECRET=

# MCP platform (Streamable HTTP at /v1/mcp — same Nest process)
MCP_ENABLED=1
MCP_PUBLIC_ENABLED=0
