# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# API
API_PORT=3001
DATABASE_URL=postgresql://delorey:delorey@127.0.0.1:55432/delorey
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me-in-production
CORS_ORIGINS=http://localhost:3010,http://localhost:5173

# AI Gateway (Slice 01 — optional; mock mode works without key)
AI_GATEWAY_MODE=mock
OPENAI_API_KEY=

TELEGRAM_LIVE=0
TELEGRAM_CREDENTIALS_KEY=
BALE_LIVE=0
BALE_CREDENTIALS_KEY=
PUBLIC_API_BASE_URL=http://localhost:3001
WORKSPACE_APP_URL=http://localhost:3010

# Shopify (Slice 13) — Custom app Admin API token works without OAuth.
# OAuth needs SHOPIFY_API_KEY + SHOPIFY_API_SECRET from Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
SHOPIFY_CREDENTIALS_KEY=
SHOPIFY_API_VERSION=2024-10
# Local webhook testing without HMAC: SHOPIFY_WEBHOOK_RELAXED=1
SHOPIFY_WEBHOOK_RELAXED=0

# Jobs (Slice 15) — BullMQ on Redis. SYNC_INLINE=1 forces sync/webhook without queue.
REDIS_URL=redis://127.0.0.1:6379
SYNC_INLINE=0

# WooCommerce (Slice 16) — REST API keys from WP Admin → WooCommerce → Settings → Advanced → REST API
WOOCOMMERCE_API_VERSION=wc/v3
WOOCOMMERCE_CREDENTIALS_KEY=
# Local webhook testing without signature: WOOCOMMERCE_WEBHOOK_RELAXED=1
WOOCOMMERCE_WEBHOOK_RELAXED=0

# BoxAPI Instagram Official API — Growth evaluation spike only (not MVP).
# Docs: docs/07-evaluations/boxapi-instagram-official-api/
# BOXAPI_BASE_URL comes from vendor panel (Official docs use YOUR_BASE_URL).
BOXAPI_SPIKE_ENABLED=0
BOXAPI_LIVE=0
BOXAPI_API_KEY=
BOXAPI_BASE_URL=
BOXAPI_WEBHOOK_SECRET=
